# Copy to .env.local for a local build, or set as environment variables in the
# GitHub Actions workflow. All of these are optional and read at build time.

# Set by the deploy workflow from the repository (actions/configure-pages).
# Locally, only to test a build under a sub-path, e.g. a project repo:
# NEXT_PUBLIC_BASE_PATH=/ahmed.dev
# NEXT_PUBLIC_SITE_URL=https://ahmed-emad-nasr.github.io/ahmed.dev
